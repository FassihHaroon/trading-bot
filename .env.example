# ── BINANCE API KEYS ──────────────────────────────────────────────────────────
# Get your keys from: https://www.binance.com/en/my/settings/api-management
# Enable "Futures Trading" permission on the key.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# ── TRADING PARAMETERS ────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
ACCOUNT_EQUITY=10000
MAX_RISK_PCT=0.01

# ── EXECUTION MODE ────────────────────────────────────────────────────────────
# WARNING: Keep false unless you want real order execution
LIVE_TRADING_ENABLED=false

# ── EXTERNAL DATA (all free, no keys required) ────────────────────────────────
USE_FEAR_GREED=true
USE_NEWS_SENTIMENT=true
USE_MACRO_CALENDAR=true

# ── AI REPORTS (Google Gemini free tier) ─────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
